# ===== MangaBooka: গোপন সেটিংসের তালিকা =====
# এই ফাইলটি কপি করে লোকাল পিসিতে `.env` নাম দিন (GitHub-এ কখনো .env দেবেন না)
# Render-এ এগুলো Environment Variables হিসেবে বসাবেন

NODE_ENV=production
PORT=3000

# সাইটের পাবলিক লিংক (শেষে / দেবেন না)
SITE_URL=https://mangabooka.onrender.com

# Firebase সার্ভিস অ্যাকাউন্ট JSON-এর base64 (নিচের গাইড দেখুন)
FIREBASE_SERVICE_ACCOUNT=

# শুধু আপনার অ্যাডমিন UID (Firebase Auth থেকে কপি). একাধিক হলে কমা দিয়ে
ADMIN_UIDS=

# শুধু লোকাল ডেভেলপমেন্টে লাগে (কমা দিয়ে)
CLIENT_ORIGIN=

# ---- পরের ব্যাচে লাগবে ----
# Gemini কী (৩টি, কমা দিয়ে)
GEMINI_KEYS=
GEMINI_MODEL=
# imgbb কী (অ্যাডমিন লগইনের পর সার্ভার থেকে দেওয়া হবে, কোডে থাকবে না)
IMGBB_KEY=

# ---- ফ্রন্টএন্ডের Firebase কনফিগ (পাবলিক মান, গোপন নয়) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
